{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/whatif-shorts/storyboard.schema.json",
  "title": "What-If Shorts â€” Film-Ready Three.js Storyboard v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "scientific_model",
    "creative_direction",
    "audio",
    "captions",
    "scenes",
    "asset_plan",
    "distribution",
    "delivery",
    "thumbnail"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "title",
        "slug",
        "format",
        "width",
        "height",
        "fps",
        "duration_s",
        "language",
        "audience",
        "platforms",
        "core_question"
      ],
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 8
        },
        "title": {
          "type": "string",
          "minLength": 8,
          "maxLength": 90
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "format": {
          "const": "9:16"
        },
        "width": {
          "const": 1080
        },
        "height": {
          "const": 1920
        },
        "fps": {
          "const": 30
        },
        "duration_s": {
          "type": "integer",
          "minimum": 45,
          "maximum": 90,
          "description": "Video duration 45â€“90 seconds inclusive; 46â€“56 seconds target for high-retention simulations."
        },
        "language": {
          "const": "en"
        },
        "audience": {
          "type": "string"
        },
        "platforms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "youtube_shorts",
              "tiktok",
              "instagram_reels",
              "facebook_reels",
              "x_video"
            ]
          },
          "minItems": 5
        },
        "core_question": {
          "type": "string",
          "minLength": 8
        },
        "viewer_takeaway": {
          "type": "string",
          "minLength": 12
        }
      }
    },
    "scientific_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_reality",
        "counterfactual_change",
        "assumptions",
        "causal_chain",
        "uncertainties",
        "claims",
        "sources"
      ],
      "properties": {
        "baseline_reality": {
          "type": "string",
          "minLength": 15
        },
        "counterfactual_change": {
          "type": "string",
          "minLength": 15
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "causal_chain": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claims": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "statement",
              "confidence",
              "reasoning",
              "presentation_guardrail"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^CL[0-9]{2}$"
              },
              "statement": {
                "type": "string",
                "minLength": 8
              },
              "confidence": {
                "enum": [
                  "established",
                  "derived",
                  "plausible",
                  "speculative"
                ]
              },
              "reasoning": {
                "type": "string",
                "minLength": 12
              },
              "presentation_guardrail": {
                "type": "string",
                "minLength": 8
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "url",
              "supports_claim_ids"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              "supports_claim_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^CL[0-9]{2}$"
                }
              }
            }
          }
        }
      }
    },
    "creative_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logline",
        "visual_identity",
        "palette",
        "lighting",
        "camera_language",
        "motion_language",
        "world_scale_policy",
        "emotional_arc",
        "opening_hook",
        "ending_payoff",
        "loop_connection",
        "asset_policy"
      ],
      "properties": {
        "logline": {
          "type": "string"
        },
        "visual_identity": {
          "type": "string"
        },
        "palette": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "type": "string"
          }
        },
        "lighting": {
          "type": "string"
        },
        "camera_language": {
          "type": "string"
        },
        "motion_language": {
          "type": "string"
        },
        "world_scale_policy": {
          "type": "string"
        },
        "emotional_arc": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "opening_hook": {
          "type": "string"
        },
        "mid_video_rehook": {
          "type": "string",
          "minLength": 12,
          "description": "Pattern-interrupt reveal or survival escalation at ~45-55% runtime to prevent mid-video swipe-away."
        },
        "ending_payoff": {
          "type": "string"
        },
        "loop_connection": {
          "type": "string"
        },
        "asset_policy": {
          "type": "string"
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voice_style",
        "voice_engine_preference",
        "narration_target_wpm",
        "music_direction",
        "music_level_db_below_voice",
        "sfx_direction",
        "mix_target_lufs",
        "true_peak_max_dbtp"
      ],
      "properties": {
        "voice_style": {
          "enum": [
            "Calm, peaceful, warm adult male; intimate documentary voice; natural breathing; wonder without shouting",
            "Crisp, urgent, fascinated adult male; high-tension simulation narrator; brisk opening cadence"
          ]
        },
        "voice_engine_preference": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "kokoro_local",
              "piper_local",
              "other_local_licensed"
            ]
          }
        },
        "narration_target_wpm": {
          "type": "integer",
          "minimum": 120,
          "maximum": 170
        },
        "music_direction": {
          "type": "string",
          "minLength": 12
        },
        "music_level_db_below_voice": {
          "type": "number",
          "minimum": -30,
          "maximum": -12
        },
        "sfx_direction": {
          "type": "string"
        },
        "mix_target_lufs": {
          "type": "number",
          "minimum": -20,
          "maximum": -12
        },
        "true_peak_max_dbtp": {
          "type": "number",
          "maximum": -1
        },
        "voice_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "description": "Optional exact local voice identifier; overrides config/narration.json. CLI --voice has highest priority."
        }
      }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "source",
        "style",
        "font_stack",
        "font_size_px",
        "max_lines",
        "max_chars_per_line",
        "safe_area",
        "active_word_treatment",
        "highlights_policy"
      ],
      "properties": {
        "mode": {
          "const": "burned_in_kinetic"
        },
        "source": {
          "const": "exact_spoken_narration"
        },
        "style": {
          "type": "string"
        },
        "font_stack": {
          "type": "string"
        },
        "font_size_px": {
          "type": "integer",
          "minimum": 48,
          "maximum": 92
        },
        "max_lines": {
          "const": 2
        },
        "max_chars_per_line": {
          "type": "integer",
          "minimum": 12,
          "maximum": 32
        },
        "safe_area": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "left_px",
            "right_px",
            "top_px",
            "bottom_px",
            "caption_baseline_y_px"
          ],
          "properties": {
            "left_px": {
              "type": "integer",
              "minimum": 60
            },
            "right_px": {
              "type": "integer",
              "minimum": 60
            },
            "top_px": {
              "type": "integer",
              "minimum": 150
            },
            "bottom_px": {
              "type": "integer",
              "minimum": 200
            },
            "caption_baseline_y_px": {
              "type": "integer",
              "minimum": 950,
              "maximum": 1560
            }
          }
        },
        "active_word_treatment": {
          "type": "string"
        },
        "highlights_policy": {
          "type": "string"
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "beat",
          "start_s",
          "end_s",
          "narration",
          "viewer_question",
          "visual_payoff",
          "shots",
          "caption_emphasis",
          "audio_cues",
          "claim_ids",
          "transition_out"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[0-9]{2}$"
          },
          "beat": {
            "enum": [
              "hook",
              "premise",
              "mechanism",
              "escalation",
              "human_impact",
              "second_order_effect",
              "twist",
              "ending"
            ]
          },
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "end_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "viewer_question": {
            "type": "string"
          },
          "visual_payoff": {
            "type": "string",
            "minLength": 15
          },
          "narration": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "start_s",
              "end_s",
              "delivery_note"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 15
              },
              "start_s": {
                "type": "number",
                "minimum": 0
              },
              "end_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "delivery_note": {
                "type": "string"
              },
              "pacing_energy": {
                "enum": [
                  "fast_hook",
                  "crisp_mechanism",
                  "steady_escalation",
                  "weighty_impact",
                  "reflective_payoff",
                  "loop_bridge"
                ],
                "description": "Selects the per-scene Kokoro speed in tools/narrate.mjs; emotional delivery notes are editorial intent, not model style prompts."
              },
              "performance": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "rate": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 1.2,
                    "description": "Explicit absolute Kokoro speed, overriding pacing_energy for this scene; measure the resulting WPM."
                  },
                  "pauses": {
                    "type": "array",
                    "maxItems": 6,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "after_word",
                        "duration_s"
                      ],
                      "properties": {
                        "after_word": {
                          "type": "integer",
                          "minimum": 1,
                          "description": "1-based token count in narration.text split on whitespace; must precede another word and be unique within the scene."
                        },
                        "duration_s": {
                          "type": "number",
                          "minimum": 0.05,
                          "maximum": 0.6,
                          "description": "Desired word-boundary gap in seconds; existing silence counts toward it. Default mode minimum only extends it, target may also contract it safely. Maximum sum 1.2s per scene; requires a verified quiet boundary."
                        },
                        "mode": {
                          "enum": [
                            "minimum",
                            "target"
                          ],
                          "default": "minimum",
                          "description": "minimum only extends a gap; target also contracts excessive silence, provided enough continuous verified quiet audio exists."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "shots": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "start_s",
                "end_s",
                "shot_type",
                "world",
                "camera",
                "subjects",
                "animation_plan",
                "lighting",
                "effects",
                "composition_notes"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^SH[0-9]{2}$"
                },
                "start_s": {
                  "type": "number",
                  "minimum": 0
                },
                "end_s": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "shot_type": {
                  "type": "string"
                },
                "world": {
                  "type": "string",
                  "minLength": 15
                },
                "camera": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "projection",
                    "fov_or_scale",
                    "keyframes",
                    "movement",
                    "lens_notes"
                  ],
                  "properties": {
                    "projection": {
                      "enum": [
                        "perspective",
                        "orthographic"
                      ]
                    },
                    "fov_or_scale": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "keyframes": {
                      "type": "array",
                      "minItems": 2,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "t_s",
                          "position",
                          "look_at",
                          "ease"
                        ],
                        "properties": {
                          "t_s": {
                            "type": "number",
                            "minimum": 0
                          },
                          "position": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            },
                            "minItems": 3,
                            "maxItems": 3
                          },
                          "look_at": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            },
                            "minItems": 3,
                            "maxItems": 3
                          },
                          "ease": {
                            "enum": [
                              "linear",
                              "smoothstep",
                              "ease_in_out_cubic",
                              "hold"
                            ]
                          }
                        }
                      }
                    },
                    "movement": {
                      "type": "string"
                    },
                    "lens_notes": {
                      "type": "string"
                    },
                    "handheld_sway": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "description": "Deterministic POV handheld breathing/walking sway (0 = tripod locked, 0.25-0.5 = ground-level human POV)."
                    },
                    "impulse_shake": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "at_s",
                        "duration_s",
                        "intensity"
                      ],
                      "properties": {
                        "at_s": {
                          "type": "number",
                          "minimum": 0
                        },
                        "duration_s": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 3
                        },
                        "intensity": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 2
                        }
                      }
                    }
                  }
                },
                "hud_telemetry": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Diegetic top-left simulation counter rendered via overlay-labels-v1.",
                  "required": [
                    "timer_label",
                    "metric_label",
                    "start_value",
                    "end_value",
                    "unit"
                  ],
                  "properties": {
                    "timer_label": {
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 28
                    },
                    "metric_label": {
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 28
                    },
                    "start_value": {
                      "type": "number"
                    },
                    "end_value": {
                      "type": "number"
                    },
                    "unit": {
                      "type": "string",
                      "maxLength": 16
                    },
                    "alert_level": {
                      "enum": [
                        "normal",
                        "warning",
                        "critical"
                      ]
                    }
                  }
                },
                "subjects": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "kind",
                      "appearance",
                      "geometry_and_material",
                      "scale_and_accuracy",
                      "movement"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "kind": {
                        "enum": [
                          "planet",
                          "moon",
                          "sun",
                          "water",
                          "atmosphere",
                          "terrain",
                          "vegetation",
                          "architecture",
                          "human",
                          "animal",
                          "particle_system",
                          "diagram",
                          "clouds",
                          "stars",
                          "other"
                        ]
                      },
                      "appearance": {
                        "type": "string"
                      },
                      "geometry_and_material": {
                        "type": "string"
                      },
                      "scale_and_accuracy": {
                        "type": "string"
                      },
                      "movement": {
                        "type": "string"
                      },
                      "asset_hint": {
                        "type": "string"
                      }
                    }
                  }
                },
                "animation_plan": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "lighting": {
                  "type": "string"
                },
                "effects": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "composition_notes": {
                  "type": "string"
                }
              }
            }
          },
          "caption_emphasis": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "phrase",
                "treatment"
              ],
              "properties": {
                "phrase": {
                  "type": "string",
                  "minLength": 2
                },
                "treatment": {
                  "enum": [
                    "accent_color",
                    "gentle_scale",
                    "subtle_glow",
                    "none"
                  ]
                }
              }
            }
          },
          "audio_cues": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "at_s",
                "duration_s",
                "kind",
                "description",
                "relative_db"
              ],
              "properties": {
                "at_s": {
                  "type": "number",
                  "minimum": 0
                },
                "duration_s": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "kind": {
                  "enum": [
                    "impact",
                    "whoosh",
                    "ambience",
                    "texture",
                    "music_swell",
                    "silence"
                  ]
                },
                "description": {
                  "type": "string"
                },
                "relative_db": {
                  "type": "number",
                  "maximum": 0
                }
              }
            }
          },
          "claim_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^CL[0-9]{2}$"
            }
          },
          "transition_out": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "duration_s",
              "motivation"
            ],
            "properties": {
              "type": {
                "enum": [
                  "cut",
                  "match_cut",
                  "cross_dissolve",
                  "whip_pan",
                  "light_wipe",
                  "orbit_match",
                  "none"
                ]
              },
              "duration_s": {
                "type": "number",
                "minimum": 0,
                "maximum": 1.5
              },
              "motivation": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "video_output",
        "video_codec",
        "pixel_format",
        "audio_codec",
        "audio_sample_rate_hz",
        "render_method",
        "captions_burned_in",
        "use_paid_apis",
        "success_reply"
      ],
      "properties": {
        "video_output": {
          "type": "string",
          "pattern": "^output/[a-z0-9-]+\\.mp4$"
        },
        "video_codec": {
          "const": "h264"
        },
        "pixel_format": {
          "const": "yuv420p"
        },
        "audio_codec": {
          "const": "aac"
        },
        "audio_sample_rate_hz": {
          "const": 48000
        },
        "render_method": {
          "const": "deterministic_frame_by_frame"
        },
        "captions_burned_in": {
          "const": true
        },
        "use_paid_apis": {
          "const": false
        },
        "success_reply": {
          "const": "absolute_mp4_path_only"
        }
      }
    },
    "asset_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "library_mode",
        "library_snapshot_note",
        "existing_assets_to_reuse",
        "new_reusable_asset_candidates",
        "shot_specific_assets"
      ],
      "properties": {
        "library_mode": {
          "const": "reuse_before_create"
        },
        "library_snapshot_note": {
          "type": "string",
          "minLength": 8
        },
        "existing_assets_to_reuse": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "asset_id",
              "usage",
              "configuration"
            ],
            "properties": {
              "asset_id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "usage": {
                "type": "string",
                "minLength": 8
              },
              "configuration": {
                "type": "string",
                "minLength": 4
              }
            }
          }
        },
        "new_reusable_asset_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "proposed_id",
              "description",
              "reusable_in",
              "parameters",
              "suggested_path"
            ],
            "properties": {
              "proposed_id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "description": {
                "type": "string",
                "minLength": 12
              },
              "reusable_in": {
                "type": "string",
                "minLength": 8
              },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "suggested_path": {
                "type": "string",
                "pattern": "^(src/library/|assets/library/).+"
              }
            }
          }
        },
        "shot_specific_assets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_search_intent",
        "core_keywords",
        "distinctive_angle",
        "seo_integrity_note"
      ],
      "properties": {
        "primary_search_intent": {
          "type": "string",
          "minLength": 12
        },
        "core_keywords": {
          "type": "array",
          "minItems": 4,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "distinctive_angle": {
          "type": "string",
          "minLength": 12
        },
        "comment_bait_question": {
          "type": "string",
          "minLength": 10,
          "description": "Interactive map or personal survival question appended to social captions (e.g., 'Where would you be on the map? ðŸ‘‡')."
        },
        "seo_integrity_note": {
          "type": "string",
          "minLength": 15
        }
      }
    },
    "thumbnail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_s",
        "headline"
      ],
      "description": "Cover image rendered with the final video as output/<slug>.jpg: a clean still (no captions or labels) at time_s, composed as a bold, click-worthy cover (default) or a clean title card.",
      "properties": {
        "time_s": {
          "type": "number",
          "minimum": 0,
          "description": "Film time of the still: the most striking, instantly readable moment, outside cross-dissolves."
        },
        "headline": {
          "type": "string",
          "minLength": 3,
          "maxLength": 38,
          "description": "Truthful curiosity hook in 2-5 punchy words (often ending in ?!); drawn in huge outlined capitals."
        },
        "highlight": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Words of the headline drawn in the accent colour."
        },
        "position": {
          "enum": [
            "top",
            "middle",
            "bottom"
          ],
          "description": "Where the headline sits; keep it clear of the subject."
        },
        "badge": {
          "type": "string",
          "minLength": 2,
          "maxLength": 28,
          "description": "Sticker text: a striking true number or twist the film shows, e.g. \"3,900,000 G\"."
        },
        "badge_at": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": "Sticker centre [x, y] as fractions of the frame (default: attached to the headline)."
        },
        "focus": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": "Subject point [x, y] as fractions of the frame: punch-in centre and arrow target."
        },
        "zoom": {
          "type": "number",
          "minimum": 1,
          "maximum": 2,
          "description": "Punch-in toward the focus (1 = none; default 1.12 with a focus)."
        },
        "anchor": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": "Where the focus lands on the cover [x, y] (fractions); lets the punch-in move the subject to make room for text."
        },
        "arrow": {
          "type": "boolean",
          "description": "Arrow from the sticker to the focus (default true when both exist)."
        },
        "style": {
          "enum": [
            "bold",
            "clean"
          ],
          "description": "bold (default): punchy cover with sticker and arrow; clean: plain headline title card."
        },
        "font": {
          "enum": [
            "inter",
            "anton",
            "bebas-neue",
            "archivo-black",
            "bangers",
            "orbitron",
            "playfair"
          ],
          "description": "Headline face, chosen for the niche (see assets/library/fonts/display/FONTS.md); default inter."
        },
        "palette": {
          "type": "object",
          "additionalProperties": false,
          "description": "Cover colours chosen for the subject and mood; defaults: white text, yellow highlight and arrow, red sticker with white text.",
          "properties": {
            "text": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "description": "Headline colour."
            },
            "highlight": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "description": "Highlighted words."
            },
            "badge": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "description": "Sticker fill."
            },
            "badge_text": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "description": "Sticker text."
            },
            "arrow": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "description": "Arrow fill (defaults to the highlight colour)."
            }
          }
        },
        "grade": {
          "enum": [
            "vivid",
            "cool",
            "warm",
            "dramatic",
            "natural"
          ],
          "description": "Colour grade of the still; default vivid."
        },
        "tilt": {
          "type": "number",
          "minimum": -10,
          "maximum": 10,
          "description": "Headline tilt in degrees; default -3."
        }
      }
    }
  }
}
